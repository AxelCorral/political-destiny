# La V1 ne requiert aucun secret ni service distant.
NEXT_PUBLIC_APP_ENV=local

# --- Analytics (docs/analytics/README.md) ----------------------------------
# Tout ce bloc est optionnel : sans ces variables, le jeu fonctionne
# normalement et la couche analytics est simplement désactivée (aucune
# erreur, aucun impact joueur — voir docs/analytics/README.md §2).

# Base Supabase (serveur uniquement — jamais préfixées NEXT_PUBLIC_, jamais
# exposées au navigateur). Laisser vide en local si vous ne testez pas
# l'ingestion réelle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Authentification du dashboard /admin/analytics. Sans ces deux variables,
# /admin/login refuse toute connexion (voir src/app/admin/admin-actions.ts).
# Choisissez des valeurs longues et aléatoires en production — jamais les
# valeurs d'exemple ci-dessous.
ANALYTICS_ADMIN_PASSWORD=change-me
ANALYTICS_ADMIN_SESSION_SECRET=change-me-too-long-random-string

# off (par défaut hors production) | opt-in (par défaut en production).
# Voir src/analytics/config.ts.
NEXT_PUBLIC_ANALYTICS_MODE=

# INFORMATIONNEL SEULEMENT — cette variable n'est lue par aucun code
# applicatif. La seule source de vérité réelle pour le seuil "run resté sans
# événement depuis N heures ⇒ stale_incomplete" est la ligne
# analytics_settings.stale_run_hours dans Postgres (une vue SQL ne peut pas
# lire une variable d'environnement Next.js). Sert uniquement à documenter
# la valeur par défaut au déploiement — voir docs/analytics/
# VERSIONING_POLICY.md et DATA_DICTIONARY.md pour la commande SQL à exécuter
# si vous changez ce nombre.
ANALYTICS_STALE_RUN_HOURS_DEFAULT=48

# Renseigné par la plateforme de déploiement si disponible ; "dev" en local.
NEXT_PUBLIC_BUILD_SHA=

